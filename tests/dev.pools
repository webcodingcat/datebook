# Test pools in development mode, for bin/run of wp-test-env
# (https://github.com/saijsaij/wp-test-env). Paths are relative to the workspace of
# wp-test-env: the directory that contains this project (wp-test-env checked out next
# to it, or WP_TEST_ENV_WORKSPACE), e.g.
#
#   bin/run ../datebook/tests/dev.pools
#
# The plugin runs on the default theme of WordPress.
prepare datebook

pool datebook
instances 2
plugins datebook
e2e datebook
