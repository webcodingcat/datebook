<div {{ block_wrapper_attributes({class: 'datebook-map-block'}) }}>
    {% if map %}
        {% include 'Block/Map/MapCanvas.twig' with {map: map} only %}
    {% elseif is_editor() %}
        <p class="datebook:m-0 datebook:rounded-md datebook:border datebook:border-dashed datebook:border-current/40 datebook:p-6 datebook:text-center">{{ __('Choose a venue with coordinates in the block settings.') }}</p>
    {% endif %}
</div>
